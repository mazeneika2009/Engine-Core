{
  "name": "engine-core",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/server & npm run dev --workspace apps/client",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:client": "npm run dev --workspace apps/client",
    "build": "npm run build --workspace apps/client",
    "migrate": "npm run migrate --workspace apps/server",
    "test:engine": "npm run test:engine --workspace apps/server"
  }
}
